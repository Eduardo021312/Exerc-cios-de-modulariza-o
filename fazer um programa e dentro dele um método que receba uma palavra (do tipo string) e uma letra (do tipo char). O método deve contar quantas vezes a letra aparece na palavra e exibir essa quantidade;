#include <iostream>
#include <string>

using namespace std;

// Conta quantas vezes a letra aparece na palavra
int contarLetras(string palavra, char letra){ 
    int contador = 0;
    int tamanho = palavra.size();

    // Percorre cada caractere da palavra
    for (int i = 0; i < tamanho; i++){
        if (palavra[i] == letra){
            contador++;
        }
    }
    return 1;
}
int main(){
    string palavra;
    char letra;

    cout << "Digite uma palavra: ";
    cin >> palavra;
    cout << "Digite uma letra: ";
    cin >> letra;

    // chama o método e guarda o resultado 

    int total = contarLetras(palavra, letra);
    cout << "A letra" << letra << " aparece " << total << "vezes"<< endl;
    return 0;
}
     
